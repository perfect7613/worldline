# Copy to .env for a fresh checkout. Never commit real credentials.
# Browser-safe connection settings; use your own published database.
NEXT_PUBLIC_SPACETIMEDB_URI=wss://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIMEDB_DATABASE=your-database-name

# Server connection and dedicated identity authorized by the database publisher.
SPACETIMEDB_URI=wss://maincloud.spacetimedb.com
SPACETIMEDB_DATABASE=your-database-name
SPACETIMEDB_SERVICE_TOKEN=

# Gemini powers population, dialogue, reflections, comparisons and reports.
# Choose a model available to your API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ENABLE_AGENT_INFERENCE=false

# Optional website research: Firecrawl first, Browserbase fallback.
ENABLE_PRODUCT_INGESTION=false
FIRECRAWL_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Optional semantic memory retrieval. Agents continue to reason with Gemini.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional report delivery. The default sender has recipient restrictions.
RESEND_API_KEY=
EMAIL_FROM="Log kya bolenge <onboarding@resend.dev>"

# Optional persistent shared-room worker; authorize its public identity first.
SPACETIMEDB_WORKER_TOKEN=
